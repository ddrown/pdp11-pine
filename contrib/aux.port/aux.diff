+ #define MAX_SEARCH       (100)  /* Longest string to search for             */
+ #define MAX_ADDR_EXPN   (1000)  /* Longest expanded addr                    */
+ #define MAX_ADDR_FIELD (10000)  /* Longest fully-expanded addr field        */
+ 
+ 
+ #endif /* _OS_INCLUDED */

#
#     Make file for the Pine mail system for BSD 4.3
#
#
#   Most commonly fiddled flags for compiler.
#   Uncomment the setttings desired here
#
RM=          rm -f
LN=          ln -s
MAKE=        make
OPTIMIZE=    # -O
PROFILE=     # -pg
DEBUG=       -g -DDEBUG

LIBES=       -ltermlib
LOCLIBES=    ../pico/libpico.a ../c-client/c-client.a

# BSD gets defined in param.h so don't redefine here.
CFLAGS= $(OPTIMIZE) $(PROFILE) $(DEBUG)

obj=    addrutil.o args.o context.o filter.o \
	folder.o help.o helptext.o init.o mailcmd.o mailindx.o \
	mailview.o newmail.o pine.o reply.o screen.o \
	send.o signals.o status.o strings.o ttyin.o ttyout.o os.o log.o \
	mailbox.o

cfiles= addrutil.c args.c context.c filter.c \
	folder.c help.c helptext.c init.c mailcmd.c mailindx.c \
	mailview.c newmail.c pine.c reply.c screen.c \
	send.c signals.c status.c strings.c ttyin.c ttyout.c os.c log.c \
	mailbox.c

pine:  $(obj) $(LOCLIBES)
	echo "char datestamp[]="\"`date`\"";" > date.c
	$(CC) -c $(CFLAGS) -o date.o date.c
	$(CC) $(LDFLAGS) $(CFLAGS) -o pine $(obj) date.o $(LOCLIBES) $(LIBES)

#
# pine is well over the PDP-11's 64KB text-segment limit too (same
# problem as pico -- see pico/makefile.bsd's pico-ovl for the
# background: mkovmake wants every .o file loose, not archived into a
# library, so it can see cross-file calls and decide what goes in the
# resident base vs. the swapped-in overlays).
#
# Tried keeping $(LOCLIBES) (libpico.a, c-client.a) archived first,
# mirroring how pico-ovl leaves -ltermcap archived -- that doesn't
# work here: per ld(1)'s overlay rules, anything pulled from a library
# placed after the concluding -Y lands in the same base-text budget as
# everything before the first -Z (base rounded to 8Kb + largest
# overlay rounded to 8Kb must be <= 64Kb total), with *no* overlay
# opportunity for it at all. That's fine for pico-ovl's tiny
# -ltermcap, but not for two libraries as large as our own pico/
# c-client code -- real hardware confirmed it ("ld:
# /usr/lib/libtermlib.a(termcap.o): text overflow", the base budget
# finally breaking once termcap.o's pulled-in text landed on top of
# whatever libpico.a/c-client.a needed). So their member .o's are
# listed loose here instead, same treatment as pine's own $(obj), so
# mkovmake's optimizer can place them in overlays too rather than
# forcing all of it into base. This assumes ../pico and ../c-client
# have already been built (via their own makefile.bsd's `all' target)
# so those loose .o's exist; the lists below must be kept in sync with
# pico/makefile.bsd's $(OFILES) and ../c-client/makefile.bsd's
# c-client.a member list.
#
# An earlier attempt at this (loose objects, unhinted -O2, no -Z) hit
# a different real failure ("ld: too big for type 431") from letting
# mkovmake freely pick its own base across all ~50 combined modules --
# consistent with an oversized auto-guessed base blowing the same
# base+overlay <= 64Kb ceiling. -O2 takes an optional basesize argument
# to cap that guess instead of letting it pick freely; ld(1)'s own
# worked example uses an 8Kb base against a 56Kb overlay, hence the
# starting point below. This is very likely NOT the right number --
# it's a first data point to bracket from, not a considered choice.
# Try both directions (basesize up if 8k undershoots and mkovmake
# can't fit enough in base to satisfy required cross-references,
# ovsize/basesize tuned down if 8k overshoots) and see what mkovmake
# actually reports.
#
MKOVMAKE=	mkovmake
MKOVFLAGS=	-O2 8k

PICOOFILES=	../pico/basic.o ../pico/bind.o ../pico/browse.o \
		../pico/buffer.o ../pico/composer.o ../pico/compose_stub.o \
		../pico/display.o ../pico/file.o ../pico/fileio.o \
		../pico/line.o ../pico/osdep.o ../pico/pico.o \
		../pico/random.o ../pico/region.o ../pico/search.o \
		../pico/tcap.o ../pico/window.o ../pico/word.o

CCLIENTOFILES=	../c-client/mail.o ../c-client/bezerk.o \
		../c-client/dummy.o ../c-client/rfc822.o \
		../c-client/misc.o ../c-client/osdep.o

pine-ovl:	$(obj) $(PICOOFILES) $(CCLIENTOFILES)
	echo "char datestamp[]="\"`date`\"";" > date.c
	$(CC) -c $(CFLAGS) -o date.o date.c
	$(MKOVMAKE) $(MKOVFLAGS) -o pine -f mkov \
		$(obj) date.o $(PICOOFILES) $(CCLIENTOFILES) $(LIBES)
	$(RM) pine
	$(MAKE) -f mkov

# this is not part of pine
pine-use:	pine-use.c
	$(CC) -o pine-use pine-use.c

clean:
	$(RM) *.o os.h os.c helptext.c helptext.h
	cd osdep; make clean; cd ..


HEADERS= headers.h pine.h os.h helptext.h context.h \
	  ../c-client/mail.h ../c-client/osdep.h

addrutil.o:	addrutil.c  $(HEADERS)
args.o:		args.c      $(HEADERS)
context.o:	context.c   $(HEADERS) ../c-client/misc.h
filter.o:	filter.c    $(HEADERS) ../pico/pico.h
folder.o:	folder.c    $(HEADERS)
help.o:		help.c      $(HEADERS)
helptext.o:	helptext.c
init.o:		init.c      $(HEADERS)
mailcmd.o:	mailcmd.c   $(HEADERS)
mailindx.o:	mailindx.c  $(HEADERS)
mailview.o:	mailview.c  $(HEADERS)
newmail.o:	newmail.c   $(HEADERS)
os.o:		os.c 	    $(HEADERS)
pine.o:		pine.c      $(HEADERS)
reply.o:	reply.c     $(HEADERS)
screen.o:	screen.c    $(HEADERS)
send.o:	        send.c      $(HEADERS) ../pico/pico.h
signals.o:	signals.c   $(HEADERS)
status.o:	status.c    $(HEADERS)
strings.o:	strings.c   $(HEADERS)
ttyin.o:	ttyin.c     $(HEADERS)
ttyout.o:	ttyout.c    $(HEADERS)
log.o:	log.c    $(HEADERS)
mailbox.o:	mailbox.c    $(HEADERS)

os.h:	osdep/os-bsd.h
	$(RM) os.h
	$(LN) osdep/os-bsd.h os.h

helptext.c:	pine.hlp
		./cmplhelp.sh  < pine.hlp > helptext.c

helptext.h:	pine.hlp
		./cmplhlp2.sh  < pine.hlp > helptext.h

os.c:	osdep/os-bsd.c
	$(RM) os.c
	$(LN) osdep/os-bsd.c os.c

osdep/os-bsd.c:	osdep/bld_path osdep/canacces osdep/canonicl \
		osdep/chnge_pw osdep/coredump osdep/creatdir \
		osdep/diskquot osdep/domnames osdep/err_desc \
		osdep/expnfldr osdep/fgetpos.non osdep/filesize osdep/fltrname \
		osdep/fnexpand osdep/header osdep/hostname \
		osdep/jobcntrl osdep/lstcmpnt osdep/mimedisp \
		osdep/play_snd.non osdep/pw_stuff osdep/readfile \
		osdep/rename osdep/tempfile osdep/tempnam osdep/writ_dir \
		osdep/os-bsd.ic
	cd osdep; $(MAKE) includer os-bsd.c; cd ..

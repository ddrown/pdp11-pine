#
#     Make file for the Pine mail system for BSD 4.3
#
#
#   Most commonly fiddled flags for compiler.
#   Uncomment the setttings desired here
#
RM=          rm -f
LN=          ln -s
MAKE=        make
OPTIMIZE=    # -O
PROFILE=     # -pg
DEBUG=       -g -DDEBUG

LIBES=       -ltermlib
# NB: no ../pico/libpico.a here -- pine hasn't called into pico's
# editor internals in-process since send.c's run_composer_subprocess()
# switched to fork()/execl()ing a separate `pico -P ...` child (see
# TODO-pdp11.md/TODO-pdp11-done.md). Confirmed via nm: zero overlap
# between every undefined symbol in pine's own object files and every
# symbol defined across all of libpico.a's member .o's, and relinking
# without it produces a byte-for-byte identical binary. Selective
# archive linking already pulled zero members from it for that reason
# (ld only pulls a library member that resolves an outstanding
# undefined reference), so this line was always contributing 0 bytes
# here -- dropped for clarity, not size (see pine-ovl below for where
# dropping the *loose* equivalent actually mattered).
LOCLIBES=    ../c-client/c-client.a

# BSD gets defined in param.h so don't redefine here.
CFLAGS= $(OPTIMIZE) $(PROFILE) $(DEBUG)

# Explicit .c.o rule, not just the default one -- pine-ovl's
# $(CCLIENTOFILES) prerequisites (e.g. ../c-client/mail.o) have a
# directory prefix, and if make's builtin suffix rule (`$(CC)
# $(CFLAGS) -c $<`, no -o) ever fires for one of them -- e.g. because
# timestamps make it look stale -- `cc -c ../c-client/mail.c` drops
# the result as bare `mail.o` in *this* directory instead of at
# ../c-client/mail.o, since cc strips the source's directory prefix
# from its default output name. Adding -o $@ here is a no-op for
# same-directory files (pine's own $(obj)) and fixes it for prefixed
# ones. $@/$< are original Make substitutions, not a GNU-ism.
.c.o:
	$(CC) $(CFLAGS) -c -o $@ $<

obj=    addrutil.o args.o context.o filter.o \
	folder.o help.o helptext.o init.o mailcmd.o mailindx.o \
	mailview.o newmail.o pine.o reply.o screen.o \
	send.o signals.o status.o strings.o ttyin.o ttyout.o os.o log.o \
	mailbox.o

cfiles= addrutil.c args.c context.c filter.c \
	folder.c help.c helptext.c init.c mailcmd.c mailindx.c \
	mailview.c newmail.c pine.c reply.c screen.c \
	send.c signals.c status.c strings.c ttyin.c ttyout.c os.c log.c \
	mailbox.c

# $(obj) minus signals.o, for pine-ovl below -- signals.o is forced
# into mkovmake's base there instead of left for the optimizer, so it
# has to be left out of the overlay-eligible list passed after -Z.
ovlobj= addrutil.o args.o context.o filter.o \
	folder.o help.o helptext.o init.o mailcmd.o mailindx.o \
	mailview.o newmail.o pine.o reply.o screen.o \
	send.o status.o strings.o ttyin.o ttyout.o os.o log.o \
	mailbox.o

pine:  $(obj) $(LOCLIBES)
	echo "char datestamp[]="\"`date`\"";" > date.c
	$(CC) -c $(CFLAGS) -o date.o date.c
	$(CC) $(LDFLAGS) $(CFLAGS) -o pine $(obj) date.o $(LOCLIBES) $(LIBES)

#
# pine is well over the PDP-11's 64KB text-segment limit too (same
# problem as pico -- see pico/makefile.bsd's pico-ovl for the
# background: mkovmake wants every .o file loose, not archived into a
# library, so it can see cross-file calls and decide what goes in the
# resident base vs. the swapped-in overlays).
#
# Earlier versions of this target also force-included every pico
# object file here (PICOOFILES, loose, for the same reason c-client's
# are loose below) -- that turned out to be pure dead weight. Loose
# object files are *always* linked in, unlike an archived library
# (which only pulls in members that resolve an outstanding undefined
# reference), and pine hasn't called into pico's editor internals
# in-process since send.c's run_composer_subprocess() switched to
# fork()/execl()ing a separate `pico -P ...' child. Confirmed via nm
# that pine's own object files reference zero symbols defined anywhere
# in libpico.a, and that dropping it from the link entirely produces a
# byte-for-byte identical `pine' binary on the lnx dev build. So unlike
# c-client.a (see below), pico is simply not part of this link at all
# any more -- no PICOOFILES, loose or archived.
#
# c-client.a, on the other hand, genuinely is needed, and needs to stay
# loose rather than archived: per ld(1)'s overlay rules, anything
# pulled from a library placed after the concluding -Y lands in the
# same base-text budget as everything before the first -Z (base
# rounded to 8Kb + largest overlay rounded to 8Kb must be <= 64Kb
# total), with *no* overlay opportunity for it at all. That's fine for
# pico-ovl's tiny -ltermcap, but not for a library as large as our own
# c-client code -- real hardware confirmed it ("ld:
# /usr/lib/libtermlib.a(termcap.o): text overflow", the base budget
# finally breaking once termcap.o's pulled-in text landed on top of
# whatever c-client.a needed, back when pico.a's now-removed members
# were also competing for the same space). So c-client.a's member .o's
# are listed loose here instead, same treatment as pine's own $(obj),
# so mkovmake's optimizer can place them in overlays too rather than
# forcing all of it into base. This assumes ../c-client has already
# been built (via its own makefile.bsd's `all' target) so those loose
# .o's exist; the list below must be kept in sync with
# ../c-client/makefile.bsd's c-client.a member list.
#
# An earlier attempt at this (loose objects, unhinted -O2, no -Z) hit
# a different real failure ("ld: too big for type 431") from letting
# mkovmake freely pick its own base across all combined modules --
# consistent with an oversized auto-guessed base blowing the same
# base+overlay <= 64Kb ceiling. -O2 takes an optional basesize argument
# to cap that guess instead of letting it pick freely; ld(1)'s own
# worked example uses an 8Kb base against a 56Kb overlay, hence the
# starting point below. This is very likely NOT the right number --
# it's a first data point to bracket from, not a considered choice.
# Try both directions (basesize up if 8k undershoots and mkovmake
# can't fit enough in base to satisfy required cross-references,
# ovsize/basesize tuned down if 8k overshoots) and see what mkovmake
# actually reports.
#
MKOVMAKE=	mkovmake
MKOVFLAGS=	-O2 8k

# bezerk.o is split into bezerk.o (mailbox lifecycle/parse/write) and
# bezerk2.o (per-message fetch/flags/expunge/copy/append) -- see
# TODO-pdp11-done.md's "Split bezerk.c into two object files" entry.
# mkovmake can't place part of one .o in one overlay and part in
# another, and bezerk.o alone grew past the largest size any single
# overlay could be once its message-cache rewrite landed, regardless of
# -O level/basesize/ovsize tuning (verified: -O1 produced an identical
# base/overlay partition to -O2, and forcing a smaller ovsize just made
# mkovmake give up on placing bezerk.o at all -- "ld: too big for type
# 431" either way). Splitting removes the ceiling entirely instead of
# needing to keep bezerk.c under an exact byte count forever after.
CCLIENTOFILES=	../c-client/mail.o ../c-client/bezerk.o \
		../c-client/bezerk2.o \
		../c-client/dummy.o ../c-client/rfc822.o \
		../c-client/misc.o ../c-client/osdep.o

# $(CCLIENTOFILES) are prebuilt separately, via ../c-client's own
# makefile.bsd `all' target, which compiles with real optimization
# (CFLAGS = -g -O there vs. -g -DDEBUG, no -O, here). Give them an
# explicit no-recipe rule so make's own .c.o: rule above -- which
# uses *this* makefile's unoptimized CFLAGS -- never fires for them
# via the implicit same-basename-.c suffix match. Without this, once
# the .c.o: -o $@ fix (see above) let that implicit rule actually
# resolve to the correct ../c-client/*.o output path instead of
# mislocating it, `pine-ovl` started silently rebuilding these with
# the wrong (larger, unoptimized) flags whenever timestamps made them
# look stale, blowing the text/overlay budget on real hardware ("ld:
# too big for type 431") -- see TODO-pdp11-done.md.
$(CCLIENTOFILES): ;

# signals.o is forced into the base (before the -Z) rather than left
# for mkovmake's optimizer like everything else. Every function in it
# is a signal handler invoked directly by the kernel via a raw
# function-pointer registered with signal() -- mkovmake's "ties"
# heuristic only tracks statically-visible calls, so it has no way to
# know signals.o needs to be resident no matter which overlay was
# loaded at the moment a signal actually arrives; if it landed in a
# swapped-out overlay, the kernel would jump into whatever code that
# overlay's segment happened to have at that address instead of the
# real handler. See signals.c's winch_signal() comment and
# TODO-pdp11-done.md's gf_terminal()/gf_out_putc entry for the same
# class of hazard via an explicit function pointer instead. Unlike
# that entry's abandoned attempt to force the much larger filter.o
# into the base (~1750 lines, hit "ld: too big for type 431"),
# signals.o is small (~380 lines, nothing but signal plumbing) and
# doesn't pull in the rest of the program with it -- everything it
# calls afterward (want_to(), mail_close(), etc.) is an ordinary
# statically-visible call, which the normal overlay trampoline
# mechanism already handles correctly regardless of where the callee
# ends up.
pine-ovl:	$(obj) $(CCLIENTOFILES)
	echo "char datestamp[]="\"`date`\"";" > date.c
	$(CC) -c $(CFLAGS) -o date.o date.c
	$(MKOVMAKE) $(MKOVFLAGS) -o pine -f mkov \
		signals.o -Z $(ovlobj) date.o $(CCLIENTOFILES) $(LIBES)
	$(RM) pine
	$(MAKE) -f mkov

# this is not part of pine
pine-use:	pine-use.c
	$(CC) -o pine-use pine-use.c

clean:
	$(RM) *.o os.h os.c helptext.c helptext.h
	cd osdep; make clean; cd ..


HEADERS= headers.h pine.h os.h helptext.h context.h \
	  ../c-client/mail.h ../c-client/osdep.h

addrutil.o:	addrutil.c  $(HEADERS)
args.o:		args.c      $(HEADERS)
context.o:	context.c   $(HEADERS) ../c-client/misc.h
filter.o:	filter.c    $(HEADERS) ../pico/pico.h
folder.o:	folder.c    $(HEADERS)
help.o:		help.c      $(HEADERS)
helptext.o:	helptext.c
init.o:		init.c      $(HEADERS)
mailcmd.o:	mailcmd.c   $(HEADERS)
mailindx.o:	mailindx.c  $(HEADERS)
mailview.o:	mailview.c  $(HEADERS)
newmail.o:	newmail.c   $(HEADERS)
os.o:		os.c 	    $(HEADERS)
pine.o:		pine.c      $(HEADERS)
reply.o:	reply.c     $(HEADERS)
screen.o:	screen.c    $(HEADERS)
send.o:	        send.c      $(HEADERS) ../pico/pico.h
signals.o:	signals.c   $(HEADERS)
status.o:	status.c    $(HEADERS)
strings.o:	strings.c   $(HEADERS)
ttyin.o:	ttyin.c     $(HEADERS)
ttyout.o:	ttyout.c    $(HEADERS)
log.o:	log.c    $(HEADERS)
mailbox.o:	mailbox.c    $(HEADERS)

os.h:	osdep/os-bsd.h
	$(RM) os.h
	$(LN) osdep/os-bsd.h os.h

helptext.c:	pine.hlp
		./cmplhelp.sh  < pine.hlp > helptext.c

helptext.h:	pine.hlp
		./cmplhlp2.sh  < pine.hlp > helptext.h

os.c:	osdep/os-bsd.c
	$(RM) os.c
	$(LN) osdep/os-bsd.c os.c

osdep/os-bsd.c:	osdep/bld_path osdep/canacces osdep/canonicl \
		osdep/chnge_pw osdep/coredump osdep/creatdir \
		osdep/diskquot osdep/domnames osdep/err_desc \
		osdep/expnfldr osdep/fgetpos.non osdep/filesize osdep/fltrname \
		osdep/fnexpand osdep/header osdep/hostname \
		osdep/jobcntrl osdep/lstcmpnt osdep/mimedisp \
		osdep/play_snd.non osdep/pw_stuff osdep/readfile \
		osdep/rename osdep/tempfile osdep/tempnam osdep/writ_dir \
		osdep/os-bsd.ic
	cd osdep; $(MAKE) includer os-bsd.c; cd ..
